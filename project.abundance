        {
          "name": "sortBy",
          "ioValue": "quantity",
          "currentEquation": "quantity"
        }
      ],
      "interpreterVersion": 1,
      "code": "/**\n * Generates a cut list from all geometries in an assembly,\n * grouped by dimension and quantity. Handles nested assemblies.\n */\nfunction run(\n  partAssembly: Assembly | Assembly[] | undefined = undefined,\n  roundTo: number = 2,\n  sortBy: string = \"quantity\",\n): string {\n  if (!partAssembly) {\n    return \"No assembly connected. Please connect a geometry input.\";\n  }\n\n  // Normalize input to array\n  const assemblies = Array.isArray(partAssembly)\n    ? partAssembly\n    : [partAssembly];\n\n  // Extract all individual parts with their bounds\n  const grouped: Record<string, number> = {};\n\n  // Recursively traverse nested assemblies to find replicad geometry\n  function extractGeometries(obj: any): any[] {\n    if (!obj || typeof obj !== \"object\") return [];\n\n    // If it has a boundingBox, it's replicad geometry - return it\n    if (obj.boundingBox) {\n      return [obj];\n    }\n\n    // If it's iterable (assembly containing sub-assemblies), recurse into each\n    if (typeof obj[Symbol.iterator] === \"function\" && !Array.isArray(obj)) {\n      const results: any[] = [];\n      try {\n        for (const item of obj) {\n          // Skip strings and non-objects\n          if (item && typeof item === \"object\") {\n            results.push(...extractGeometries(item.geometry || item));\n          }\n        }\n      } catch (e) {\n        console.warn(\"Error iterating assembly:\", e);\n      }\n      return results;\n    }\n\n    // Otherwise, can't extract geometry\n    return [];\n  }\n\n  // Process all assemblies\n  assemblies.forEach((assembly) => {\n    if (!assembly) return;\n\n    const geometries = extractGeometries(assembly.geometry);\n\n    geometries.forEach((geometry) => {\n      try {\n        const bbox = geometry.boundingBox;\n        if (!bbox || !bbox.bounds) {\n          console.warn(\"No bounding box found for geometry\");\n          return;\n        }\n\n        // Extract dimensions from bounds\n        const minPoint = bbox.bounds[0];\n        const maxPoint = bbox.bounds[1];\n\n        const x = Math.abs(maxPoint[0] - minPoint[0]);\n        const y = Math.abs(maxPoint[1] - minPoint[1]);\n        const z = Math.abs(maxPoint[2] - minPoint[2]);\n\n        // Sort dimensions for consistency\n        const dims = [x, y, z]\n          .sort((a, b) => b - a)\n          .map((d) => d.toFixed(roundTo))\n          .join(\" × \");\n\n        grouped[dims] = (grouped[dims] || 0) + 1;\n      } catch (e) {\n        console.warn(\"Could not extract bounds for geometry:\", e);\n      }\n    });\n  });\n\n  if (Object.keys(grouped).length === 0) {\n    return \"No valid geometries found in assembly.\";\n  }\n\n  // Sort results\n  const sorted = Object.entries(grouped).sort((a, b) => {\n    if (sortBy === \"quantity\") {\n      return b[1] - a[1]; // Most common first\n    } else {\n      return a[0].localeCompare(b[0]); // Alphabetical\n    }\n  });\n\n  // Generate markdown table\n  let table =\n    \"| Dimensions (X × Y × Z) | Quantity |\\n|------------------------|----------|\\n\";\n  let totalParts = 0;\n\n  sorted.forEach(([dims, qty]) => {\n    table += `| ${dims} mm | ${qty} |\\n`;\n    totalParts += qty;\n  });\n\n  table += `\\n**Total Parts:** ${totalParts}`;\n\n  return table;\n}",
      "compiledCode": "\"use strict\";\n/**\n * Generates a cut list from all geometries in an assembly,\n * grouped by dimension and quantity. Handles nested assemblies.\n */\nfunction run(partAssembly = undefined, roundTo = 2, sortBy = \"quantity\") {\n    if (!partAssembly) {\n        return \"No assembly connected. Please connect a geometry input.\";\n    }\n    // Normalize input to array\n    const assemblies = Array.isArray(partAssembly)\n        ? partAssembly\n        : [partAssembly];\n    // Extract all individual parts with their bounds\n    const grouped = {};\n    // Recursively traverse nested assemblies to find replicad geometry\n    function extractGeometries(obj) {\n        if (!obj || typeof obj !== \"object\")\n            return [];\n        // If it has a boundingBox, it's replicad geometry - return it\n        if (obj.boundingBox) {\n            return [obj];\n        }\n        // If it's iterable (assembly containing sub-assemblies), recurse into each\n        if (typeof obj[Symbol.iterator] === \"function\" && !Array.isArray(obj)) {\n            const results = [];\n            try {\n                for (const item of obj) {\n                    // Skip strings and non-objects\n                    if (item && typeof item === \"object\") {\n                        results.push(...extractGeometries(item.geometry || item));\n                    }\n                }\n            }\n            catch (e) {\n                console.warn(\"Error iterating assembly:\", e);\n            }\n            return results;\n        }\n        // Otherwise, can't extract geometry\n        return [];\n    }\n    // Process all assemblies\n    assemblies.forEach((assembly) => {\n        if (!assembly)\n            return;\n        const geometries = extractGeometries(assembly.geometry);\n        geometries.forEach((geometry) => {\n            try {\n                const bbox = geometry.boundingBox;\n                if (!bbox || !bbox.bounds) {\n                    console.warn(\"No bounding box found for geometry\");\n                    return;\n                }\n                // Extract dimensions from bounds\n                const minPoint = bbox.bounds[0];\n                const maxPoint = bbox.bounds[1];\n                const x = Math.abs(maxPoint[0] - minPoint[0]);\n                const y = Math.abs(maxPoint[1] - minPoint[1]);\n                const z = Math.abs(maxPoint[2] - minPoint[2]);\n                // Sort dimensions for consistency\n                const dims = [x, y, z]\n                    .sort((a, b) => b - a)\n                    .map((d) => d.toFixed(roundTo))\n                    .join(\" × \");\n                grouped[dims] = (grouped[dims] || 0) + 1;\n            }\n            catch (e) {\n                console.warn(\"Could not extract bounds for geometry:\", e);\n            }\n        });\n    });\n    if (Object.keys(grouped).length === 0) {\n        return \"No valid geometries found in assembly.\";\n    }\n    // Sort results\n    const sorted = Object.entries(grouped).sort((a, b) => {\n        if (sortBy === \"quantity\") {\n            return b[1] - a[1]; // Most common first\n        }\n        else {\n            return a[0].localeCompare(b[0]); // Alphabetical\n        }\n    });\n    // Generate markdown table\n    let table = \"| Dimensions (X × Y × Z) | Quantity |\\n|------------------------|----------|\\n\";\n    let totalParts = 0;\n    sorted.forEach(([dims, qty]) => {\n        table += `| ${dims} mm | ${qty} |\\n`;\n        totalParts += qty;\n    });\n    table += `\\n**Total Parts:** ${totalParts}`;\n    return table;\n}\n"
    },
