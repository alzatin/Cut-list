    {
      "atomType": "Code",
      "x": 0.7298456260720412,
      "y": 0.42987804878048785,
      "uniqueID": "id-206",
      "ioValues": [
        {
          "name": "partAssembly",
          "ioValue": "__GEOMETRY_INPUT__"
        },
        {
          "name": "roundTo",
          "ioValue": 2,
          "currentEquation": "2"
        },
        {
          "name": "sortBy",
          "ioValue": "quantity",
          "currentEquation": "quantity"
        }
      ],
      "interpreterVersion": 1,
      "code": "/**\n * Generates a cut list from all geometries in an assembly,\n * grouped by dimension and quantity.\n */\nfunction run(\n  partAssembly: Assembly | Assembly[] | undefined = undefined,\n  roundTo: number = 2,\n  sortBy: string = \"quantity\",\n): string {\n  if (!partAssembly) {\n    return \"No assembly connected. Please connect a geometry input.\";\n  }\n\n  // Normalize input to array\n  const assemblies = Array.isArray(partAssembly)\n    ? partAssembly\n    : [partAssembly];\n  // Extract all individual parts with their bounds\n  const grouped: Record<string, number> = {};\n  console.log(assemblies[0].geometry)\n  assemblies[0].geometry.forEach((assembly) => {\n    if (!assembly || !assembly.geometry) return;\n\n    try {\n      // Access boundingBox property on the geometry\n      console.log(assembly.geometry)\n      const bbox = assembly.geometry.boundingBox;\n      if (!bbox || !bbox.bounds) {\n        console.warn(\"No bounding box found for part\");\n        return;\n      }\n\n      // Extract dimensions from bounds\n      const minPoint = bbox.bounds[0];\n      const maxPoint = bbox.bounds[1];\n\n      const x = Math.abs(maxPoint[0] - minPoint[0]);\n      const y = Math.abs(maxPoint[1] - minPoint[1]);\n      const z = Math.abs(maxPoint[2] - minPoint[2]);\n\n      // Sort dimensions for consistency\n      const dims = [x, y, z]\n        .sort((a, b) => b - a)\n        .map((d) => d.toFixed(roundTo))\n        .join(\" × \");\n\n      grouped[dims] = (grouped[dims] || 0) + 1;\n    } catch (e) {\n      console.warn(\"Could not extract bounds for part:\", e);\n    }\n  });\n\n  if (Object.keys(grouped).length === 0) {\n    return \"No valid geometries found in assembly.\";\n  }\n\n  // Sort results\n  const sorted = Object.entries(grouped).sort((a, b) => {\n    if (sortBy === \"quantity\") {\n      return b[1] - a[1]; // Most common first\n    } else {\n      return a[0].localeCompare(b[0]); // Alphabetical\n    }\n  });\n\n  // Generate markdown table\n  let table =\n    \"| Dimensions (X × Y × Z) | Quantity |\\n|------------------------|----------|\\n\";\n  let totalParts = 0;\n\n  sorted.forEach(([dims, qty]) => {\n    table += `| ${dims} mm | ${qty} |\\n`;\n    totalParts += qty;\n  });\n\n  table += `\\n**Total Parts:** ${totalParts}`;\n  console.log(table)\n  return table;\n}",
      "compiledCode": "\"use strict\";\n/**\n * Generates a cut list from all geometries in an assembly,\n * grouped by dimension and quantity.\n */\nfunction run(partAssembly = undefined, roundTo = 2, sortBy = \"quantity\") {\n    if (!partAssembly) {\n        return \"No assembly connected. Please connect a geometry input.\";\n    }\n    // Normalize input to array\n    const assemblies = Array.isArray(partAssembly)\n        ? partAssembly\n        : [partAssembly];\n    // Extract all individual parts with their bounds\n    const grouped = {};\n    console.log(assemblies[0].geometry);\n    assemblies[0].geometry.forEach((assembly) => {\n        if (!assembly || !assembly.geometry)\n            return;\n        try {\n            // Access boundingBox property on the geometry\n            console.log(assembly.geometry);\n            const bbox = assembly.geometry.boundingBox;\n            if (!bbox || !bbox.bounds) {\n                console.warn(\"No bounding box found for part\");\n                return;\n            }\n            // Extract dimensions from bounds\n            const minPoint = bbox.bounds[0];\n            const maxPoint = bbox.bounds[1];\n            const x = Math.abs(maxPoint[0] - minPoint[0]);\n            const y = Math.abs(maxPoint[1] - minPoint[1]);\n            const z = Math.abs(maxPoint[2] - minPoint[2]);\n            // Sort dimensions for consistency\n            const dims = [x, y, z]\n                .sort((a, b) => b - a)\n                .map((d) => d.toFixed(roundTo))\n                .join(\" × \");\n            grouped[dims] = (grouped[dims] || 0) + 1;\n        }\n        catch (e) {\n            console.warn(\"Could not extract bounds for part:\", e);\n        }\n    });\n    if (Object.keys(grouped).length === 0) {\n        return \"No valid geometries found in assembly.\";\n    }\n    // Sort results\n    const sorted = Object.entries(grouped).sort((a, b) => {\n        if (sortBy === \"quantity\") {\n            return b[1] - a[1]; // Most common first\n        }\n        else {\n            return a[0].localeCompare(b[0]); // Alphabetical\n        }\n    });\n    // Generate markdown table\n    let table = \"| Dimensions (X × Y × Z) | Quantity |\\n|------------------------|----------|\\n\";\n    let totalParts = 0;\n    sorted.forEach(([dims, qty]) => {\n        table += `| ${dims} mm | ${qty} |\\n`;\n        totalParts += qty;\n    });\n    table += `\\n**Total Parts:** ${totalParts}`;\n    console.log(table);\n    return table;\n}\n"
    },
    {
      "atomType": "Assembly",
