      "uniqueID": "id-7",
      "ioValues": [
        {
          "name": "partAssembly",
          "ioValue": "__GEOMETRY_INPUT__"
        }
      ],
      "interpreterVersion": 0,
      "code": "\n// Example Code\nconst Inputs = [\n  { inputName: \"partAssembly\", type: \"geometry\", defaultValue: null }\n];\n\nconsole.log(partAssembly)\nlet importedShape = library[partAssembly];\n\nlet parts = await AssemblyAsIterable( library[partAssembly]); // Flattens to individual leaves\nconsole.log(\"itrable\",parts)\n\n//traverse through the top level of geometry of the assembly \n\nconst partBounds = [];\n  for (let part of parts) {\n     console.log('part', part)\n    const boundsObj = await GetBounds(part);\n    const bounds = boundsObj // GetBounds returns AbundanceObject with bounds in geometry\n    console.log(\"object bounds\", bounds)\n    if (bounds) {\n      partBounds.push({\n        part: part,\n        bounds: bounds,\n      });\n    }\n  }\nreturn generateGroupedCutList(partBounds, \"table\");\n \n//return generateSimpleCutList(partBounds, \"table\");\n\n\nfunction generateSimpleCutList(partBounds, format) {\n  if (format === \"table\") {\n    let table = \"| Part | Dimensions (X x Y x Z) |\\n|------|------------------------|\\n\";\n    partBounds.forEach((item, idx) => {\n      const bounds = item.bounds;\n      const x = bounds.max[0] - bounds.min[0];\n      const y = bounds.max[1] - bounds.min[1];\n      const z = bounds.max[2] - bounds.min[2];\n      const dims = `${x.toFixed(2)} x ${y.toFixed(2)} x ${z.toFixed(2)}`;\n      table += `| Part ${idx + 1} | ${dims} |\\n`;\n    });\n    console.log(table)\n    return table;\n  } else {\n    let list = \"Cut List:\\n\";\n    partBounds.forEach((item, idx) => {\n      const bounds = item.bounds;\n      const x = bounds.max[0] - bounds.min[0];\n      const y = bounds.max[1] - bounds.min[1];\n      const z = bounds.max[2] - bounds.min[2];\n      const dims = `${x.toFixed(2)} x ${y.toFixed(2)} x ${z.toFixed(2)}`;\n      list += `- Part ${idx + 1}: ${dims}\\n`;\n    });\n    return list;\n  }\n}\nfunction generateGroupedCutList(partBounds, format) {\n  console.log(partBounds)\n  const grouped = {};\n  partBounds.forEach((item) => {\n    const bounds = item.bounds;\n    const x = bounds.max[0] - bounds.min[0];\n    const y = bounds.max[1] - bounds.min[1];\n    const z = bounds.max[2] - bounds.min[2];\n    // Use 4 decimal places instead of 2 to preserve actual differences\n    const dims = `${x.toFixed(4)} x ${y.toFixed(4)} x ${z.toFixed(4)}`;\n    grouped[dims] = (grouped[dims] || 0) + 1;\n  });\n\n  if (format === \"table\") {\n    let table = \"| Dimensions (X x Y x Z) | Quantity |\\n|------------------------|----------|\\n\";\n    Object.entries(grouped).forEach(([dims, qty]) => {\n      table += `| ${dims} | ${qty} |\\n`;\n    });\n    console.log(table)\n    return table;\n  } else {\n    let list = \"Cut List (Grouped):\\n\";\n    Object.entries(grouped).forEach(([dims, qty]) => {\n      list += `- ${dims}: ${qty} pieces\\n`;\n    });\n    return list;\n  }\n}\n\n"
    },
