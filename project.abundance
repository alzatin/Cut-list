    {
      "atomType": "Code",
      "x": 0.718696397941681,
      "y": 0.576219512195122,
      "uniqueID": "id-223",
      "ioValues": [
        {
          "name": "partAssembly",
          "ioValue": "__GEOMETRY_INPUT__"
        },
        {
          "name": "roundTo",
          "ioValue": 2
